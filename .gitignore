# 项目源码（.editorconfig 例外放行：防火墙文件，截断根配置向 src/ 嵌套仓穿透）
src/*
!src/.gitkeep
!src/.editorconfig

# lib 忽略
**/node_modules

# 临时输出（对比测试产物等），不进 git
temp/*
!temp/README.md

# 环境
.env.local
.env.temp

# agent 工具本机配置（防误提交；密钥方案上不在配置放明文副本，见 .tools/env/README.md）
.claude/settings.local.json
.codex/config.toml

# ZCode 会话产物（plans 计划文件、skills CLI 误写的副本目录；ZCode 直读 .agents/skills 真源）
.zcode/

# Claude Code skills 桥（.claude/skills/ → .agents/skills/ 的 junction）
# Windows 下 symlink 需管理员权限 → 改用 junction（mklink /J，无需特殊权限）。
# Claude Code 原生只发现 .claude/skills/，经此 junction 重定向到单一真源 .agents/skills/。
# 环境特定不进 git（core.symlinks=false 下 git 会跟随 junction 重复跟踪内容）；换机重建见 .tools/skill-bridge/
.claude/skills/

# 编程语言相关
__pycache__

# VS Code 多根工作区文件（机器相关/本地，不进 git）
*.code-workspace

# 任务 worktree 环境文件铺装（放行 README 说明，实体映射文件不进 git）
**/code-workspace-env/*
!**/code-workspace-env/README.md

# 任务取证/复现附件（截图、日志样本等敏感件仅留本地，防误入库；结论进任务目录 md）
case/**/evidence/*
